# Copier ce fichier en .env puis adapter les valeurs.

# Mot de passe de la page /admin (obligatoire, choisissez-le long).
ADMIN_PASSWORD=change-moi

# true si le site est servi en HTTPS (Nginx Proxy Manager + Let's Encrypt).
# Mettre false uniquement pour un test en http:// sans proxy.
COOKIE_SECURE=true

# Nom du réseau Docker de Nginx Proxy Manager (voir `docker network ls`).
PROXY_NETWORK=proxy

# Port publié sur 127.0.0.1 du serveur (accès local / tunnel SSH).
HOST_PORT=8000

# ---- Version multi-casernes (branche multi-casernes, pas encore en service) ----
# Activer la plateforme : une base « plateforme » + un dossier par caserne (voir docs/MULTI-CASERNES.md).
# PLATFORM_DB_PATH=/app/plateforme/plateforme.db
# CASERNES_DIR=/app/plateforme/casernes
# Mot de passe de l'admin central (adresse admin.<domaine>, page /plateforme).
# PLATFORM_ADMIN_PASSWORD=change-moi-aussi
# Domaine de la plateforme : <caserne>.<domaine> mène à chaque caserne.
# PLATFORM_DOMAIN=almaneo.fr
# Nom de la plateforme (« propulsé par … » sur les sites des casernes), Almaneo par défaut.
# PLATFORM_NAME=Almaneo

# ---- Deuxième installation sur le même serveur (Almaneo à côté de l'installation actuelle) ----
# Dans le dossier de la deuxième installation uniquement (voir docs/MISE-EN-SERVICE.md) :
# CONTAINER_NAME=almaneo
# IMAGE_NAME=almaneo-backend
# HOST_PORT=8001
# PLATFORM_CONTACT_EMAIL=contact@almaneo.fr
# PLATFORM_EDITEUR=Prénom Nom
# mentions légales (almaneo.fr/mentions-legales) : à remplir dès que le site est édité à titre professionnel
# PLATFORM_EDITEUR_ADRESSE=1 rue …, 69000 Ville
# PLATFORM_EDITEUR_SIRET=123 456 789 00012
# PLATFORM_HEBERGEUR=OVH SAS, 2 rue Kellermann, 59100 Roubaix, France — www.ovhcloud.com
